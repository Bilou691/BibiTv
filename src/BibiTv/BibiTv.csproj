<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BibiTv</AssemblyName>
    <RootNamespace>BibiTv</RootNamespace>
    <Product>BibiTV</Product>
    <Version>1.5.1</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\BibiTv.ico</ApplicationIcon>
    <!-- Seule la version 64 bits de LibVLC est embarquée -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <!-- Clé TMDB injectée à la compilation (dotnet publish -p:TmdbKey=...), jamais commitée -->
  <ItemGroup Condition="'$(TmdbKey)' != ''">
    <AssemblyMetadata Include="TmdbKey" Value="$(TmdbKey)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BibiTv.png" />
    <Resource Include="Assets\BibiTv.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.1.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
