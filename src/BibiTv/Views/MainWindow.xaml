<Window x:Class="BibiTv.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:BibiTv.Models"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:svc="clr-namespace:BibiTv.Services"
        Title="BibiTV" Icon="/Assets/BibiTv.ico" Width="1440" Height="900" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Affiche film / série -->
        <DataTemplate x:Key="PosterTemplate" DataType="{x:Type m:MediaItem}">
            <StackPanel Width="168">
                <Grid Width="168" Height="252">
                    <Border CornerRadius="14" Background="{StaticResource Surface}">
                        <TextBlock Text="{Binding Initial}" FontSize="56" FontWeight="Bold" Foreground="{StaticResource TextTertiary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ImageUrl, Converter={StaticResource PosterImage}}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="14" BorderThickness="1" BorderBrush="#14FFFFFF" />
                </Grid>
                <TextBlock Text="{Binding Title}" Margin="2,10,2,0" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <TextBlock Text="{Binding Subtitle}" Margin="2,2,2,0" FontSize="12" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </DataTemplate>

        <!-- Chaîne TV -->
        <DataTemplate x:Key="LiveTemplate" DataType="{x:Type m:MediaItem}">
            <StackPanel Width="208">
                <Grid Width="208" Height="117">
                    <Border CornerRadius="14" Background="{StaticResource Surface}">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ImageUrl, Converter={StaticResource NullToVisible}}" />
                            <Image Margin="26,18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding ImageUrl, Converter={StaticResource LogoImage}}" />
                        </Grid>
                    </Border>
                    <Border CornerRadius="14" BorderThickness="1" BorderBrush="#14FFFFFF" />
                </Grid>
                <TextBlock Text="{Binding Title}" Margin="2,10,2,0" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
            </StackPanel>
        </DataTemplate>

        <!-- Top 10 : grand numéro + affiche -->
        <LinearGradientBrush x:Key="RankBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B3FFFFFF" Offset="0" />
            <GradientStop Color="#14FFFFFF" Offset="0.9" />
        </LinearGradientBrush>

        <DataTemplate x:Key="RankedPosterTemplate" DataType="{x:Type svc:RankedItem}">
            <Grid Width="250" Height="300">
                <TextBlock Text="{Binding RankText}" FontSize="200" FontWeight="Black" Foreground="{StaticResource RankBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,40,0,0" LineHeight="200"
                           LineStackingStrategy="BlockLineHeight" />
                <StackPanel Width="168" HorizontalAlignment="Right">
                    <Grid Width="168" Height="252">
                        <Border CornerRadius="14" Background="{StaticResource Surface}">
                            <TextBlock Text="{Binding Item.Initial}" FontSize="56" FontWeight="Bold" Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Item.ImageUrl, Converter={StaticResource PosterImage}}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="14" BorderThickness="1" BorderBrush="#14FFFFFF" />
                    </Grid>
                    <TextBlock Text="{Binding Item.Title}" Margin="2,10,2,0" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Title}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RankedLiveTemplate" DataType="{x:Type svc:RankedItem}">
            <Grid Width="290" Height="160">
                <TextBlock Text="{Binding RankText}" FontSize="130" FontWeight="Black" Foreground="{StaticResource RankBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,6,0,0" LineHeight="130"
                           LineStackingStrategy="BlockLineHeight" />
                <StackPanel Width="208" HorizontalAlignment="Right">
                    <Border CornerRadius="14" Background="{StaticResource Surface}" Width="208" Height="117" BorderThickness="1" BorderBrush="#14FFFFFF">
                        <Grid>
                            <TextBlock Text="{Binding Item.Initial}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Item.ImageUrl, Converter={StaticResource NullToVisible}}" />
                            <Image Margin="26,18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Item.ImageUrl, Converter={StaticResource LogoImage}}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Item.Title}" Margin="2,10,2,0" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="TileClickable" TargetType="ListBoxItem" BasedOn="{StaticResource TileItem}">
            <EventSetter Event="MouseLeftButtonUp" Handler="Tile_Click" />
            <EventSetter Event="MouseRightButtonUp" Handler="Tile_RightClick" />
            <EventSetter Event="MouseEnter" Handler="Tile_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Tile_MouseLeave" />
            <EventSetter Event="Selected" Handler="Tile_Selected" />
        </Style>

        <Style x:Key="EpisodeClickable" TargetType="ListBoxItem" BasedOn="{StaticResource EpisodeItem}">
            <EventSetter Event="MouseLeftButtonUp" Handler="Episode_Click" />
        </Style>

        <Style x:Key="TileList" TargetType="ListBox" BasedOn="{StaticResource BareListBox}">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
            <Setter Property="VirtualizingPanel.CacheLength" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TileClickable}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel SpacingMode="Uniform" StretchItems="False" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Halo d'ambiance discret -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,-0.1" GradientOrigin="0.5,-0.1" RadiusX="0.9" RadiusY="0.7">
                <GradientStop Color="#1A1A24" Offset="0" />
                <GradientStop Color="#0A0A0C" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- ===================== CONNEXION ===================== -->
        <Grid x:Name="LoginView">
            <StackPanel Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/BibiTv.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,18" />
                <TextBlock Text="BibiTV" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Connectez votre abonnement Xtream Codes" FontSize="15" Margin="0,6,0,26"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />

                <TextBlock Text="Adresse du serveur" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <TextBox x:Name="ServerBox" Style="{StaticResource BareTextBox}" />
                </Border>

                <TextBlock Text="Nom d'utilisateur" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <TextBox x:Name="UserBox" Style="{StaticResource BareTextBox}" />
                </Border>

                <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <PasswordBox x:Name="PassBox" Style="{StaticResource BarePasswordBox}" />
                </Border>

                <Button x:Name="LoginButton" Content="Se connecter" Style="{StaticResource PrimaryButton}" Margin="0,30,0,0"
                        HorizontalAlignment="Stretch" IsDefault="True" Click="Login_Click" />
                <TextBlock x:Name="LoginError" Foreground="{StaticResource Danger}" FontSize="13" Margin="0,16,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Text="Le mot de passe est chiffré et stocké uniquement sur ce PC." FontSize="12" Margin="0,18,0,0"
                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" />
                <Button x:Name="LoginVersionButton" Style="{StaticResource GhostButton}" FontSize="12" Margin="0,6,0,0"
                        HorizontalAlignment="Center" ToolTip="Rechercher une mise à jour" Click="CheckUpdate_Click" />
            </StackPanel>
        </Grid>

        <!-- ===================== NAVIGATION ===================== -->
        <Grid x:Name="BrowseView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barre du haut -->
            <Grid Margin="32,18,32,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/BibiTv.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="BibiTV" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button x:Name="VersionButton" Style="{StaticResource GhostButton}" FontSize="12" Margin="8,2,0,0"
                            ToolTip="Rechercher une mise à jour" Click="CheckUpdate_Click" />
                </StackPanel>

                <Border Grid.Column="1" Background="#B31C1C1E" CornerRadius="22" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NavHome" Content="Accueil" GroupName="nav" Style="{StaticResource NavPill}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavLive" Content="En direct" GroupName="nav" Style="{StaticResource NavPill}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavMovies" Content="Films" GroupName="nav" Style="{StaticResource NavPill}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSeries" Content="Séries" GroupName="nav" Style="{StaticResource NavPill}" Checked="Nav_Checked" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="SearchContainer" Background="{StaticResource Surface}" CornerRadius="18" Height="36" Width="260" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Rechercher" FontSize="14" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="14"
                                     TextChanged="Search_TextChanged" />
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Downloads_Click" ToolTip="Téléchargements">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Téléchargements" />
                            <Border x:Name="DownloadBadge" Background="#0A84FF" CornerRadius="9" MinWidth="18" Height="18" Margin="8,0,0,0"
                                    Padding="5,0" Visibility="Collapsed">
                                <TextBlock x:Name="DownloadBadgeText" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Content="Déconnexion" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="Logout_Click" />
                </StackPanel>
            </Grid>


            <!-- Accueil -->
            <ScrollViewer x:Name="HomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,6,32,40">
                    <!-- Bandeau à la une -->
                    <Grid x:Name="Hero" Height="440" Visibility="Collapsed">
                        <Border CornerRadius="24" Background="{StaticResource Surface}">
                            <Border CornerRadius="24">
                                <Border.Background>
                                    <ImageBrush x:Name="HeroImage" Stretch="UniformToFill" AlignmentY="Top" />
                                </Border.Background>
                            </Border>
                        </Border>
                        <Border CornerRadius="24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F00A0A0C" Offset="0" />
                                    <GradientStop Color="#990A0A0C" Offset="0.45" />
                                    <GradientStop Color="#000A0A0C" Offset="0.85" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,44" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock x:Name="HeroKicker" FontSize="12" FontWeight="Bold" Foreground="#FFD60A" />
                            <TextBlock x:Name="HeroTitle" FontSize="44" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock x:Name="HeroMeta" FontSize="14" Foreground="#CCFFFFFF" Margin="0,8,0,0" />
                            <TextBlock x:Name="HeroPlot" FontSize="15" LineHeight="23" Foreground="#D1D1D6" TextWrapping="Wrap" Margin="0,14,0,0"
                                       MaxHeight="70" TextTrimming="WordEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Click="HeroPlay_Click" MinWidth="150">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Lecture" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Plus d'infos" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="HeroInfo_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Top 10 des films de la semaine -->
                    <Grid Margin="0,34,0,0" x:Name="TopMoviesRow">
                        <StackPanel>
                            <TextBlock Text="Top 10 des films de la semaine" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="TopMoviesSource" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE76B;" Style="{StaticResource SmallIconButton}" Tag="{Binding ElementName=TopMoviesScroll}" Click="RowLeft_Click" />
                            <Button Content="&#xE76C;" Style="{StaticResource SmallIconButton}" Margin="8,0,0,0" Tag="{Binding ElementName=TopMoviesScroll}" Click="RowRight_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="TopMoviesScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Row_PreviewMouseWheel" Margin="-10,4,-10,0">
                        <ListBox x:Name="TopMoviesList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource TileClickable}"
                                 ItemTemplate="{StaticResource RankedPosterTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Top 10 des séries de la semaine -->
                    <Grid Margin="0,34,0,0" x:Name="TopSeriesRow">
                        <StackPanel>
                            <TextBlock Text="Top 10 des séries de la semaine" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="TopSeriesSource" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE76B;" Style="{StaticResource SmallIconButton}" Tag="{Binding ElementName=TopSeriesScroll}" Click="RowLeft_Click" />
                            <Button Content="&#xE76C;" Style="{StaticResource SmallIconButton}" Margin="8,0,0,0" Tag="{Binding ElementName=TopSeriesScroll}" Click="RowRight_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="TopSeriesScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Row_PreviewMouseWheel" Margin="-10,4,-10,0">
                        <ListBox x:Name="TopSeriesList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource TileClickable}"
                                 ItemTemplate="{StaticResource RankedPosterTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Top 10 des chaînes TV en France -->
                    <Grid Margin="0,34,0,0" x:Name="TopChannelsRow">
                        <StackPanel>
                            <TextBlock Text="Top 10 des chaînes TV en France" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="TopChannelsSource" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE76B;" Style="{StaticResource SmallIconButton}" Tag="{Binding ElementName=TopChannelsScroll}" Click="RowLeft_Click" />
                            <Button Content="&#xE76C;" Style="{StaticResource SmallIconButton}" Margin="8,0,0,0" Tag="{Binding ElementName=TopChannelsScroll}" Click="RowRight_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="TopChannelsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Row_PreviewMouseWheel" Margin="-10,4,-10,0">
                        <ListBox x:Name="TopChannelsList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource TileClickable}"
                                 ItemTemplate="{StaticResource RankedLiveTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Ma liste -->
                    <Grid Margin="0,34,0,0" x:Name="MyListRow">
                        <StackPanel>
                            <TextBlock Text="Ma liste" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="MyListSource" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE76B;" Style="{StaticResource SmallIconButton}" Tag="{Binding ElementName=MyListScroll}" Click="RowLeft_Click" />
                            <Button Content="&#xE76C;" Style="{StaticResource SmallIconButton}" Margin="8,0,0,0" Tag="{Binding ElementName=MyListScroll}" Click="RowRight_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="MyListScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Row_PreviewMouseWheel" Margin="-10,4,-10,0">
                        <ListBox x:Name="MyListList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource TileClickable}"
                                 ItemTemplate="{StaticResource PosterTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Nouveaux films -->
                    <Grid Margin="0,34,0,0" x:Name="RecentMoviesRow">
                        <StackPanel>
                            <TextBlock Text="Nouveaux films" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="RecentMoviesSource" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE76B;" Style="{StaticResource SmallIconButton}" Tag="{Binding ElementName=RecentMoviesScroll}" Click="RowLeft_Click" />
                            <Button Content="&#xE76C;" Style="{StaticResource SmallIconButton}" Margin="8,0,0,0" Tag="{Binding ElementName=RecentMoviesScroll}" Click="RowRight_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="RecentMoviesScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Row_PreviewMouseWheel" Margin="-10,4,-10,0">
                        <ListBox x:Name="RecentMoviesList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource TileClickable}"
                                 ItemTemplate="{StaticResource PosterTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Nouvelles séries -->
                    <Grid Margin="0,34,0,0" x:Name="RecentSeriesRow">
                        <StackPanel>
                            <TextBlock Text="Nouvelles séries" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="RecentSeriesSource" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE76B;" Style="{StaticResource SmallIconButton}" Tag="{Binding ElementName=RecentSeriesScroll}" Click="RowLeft_Click" />
                            <Button Content="&#xE76C;" Style="{StaticResource SmallIconButton}" Margin="8,0,0,0" Tag="{Binding ElementName=RecentSeriesScroll}" Click="RowRight_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="RecentSeriesScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Row_PreviewMouseWheel" Margin="-10,4,-10,0">
                        <ListBox x:Name="RecentSeriesList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource TileClickable}"
                                 ItemTemplate="{StaticResource PosterTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <TextBlock x:Name="HomeEmpty" FontSize="16" Foreground="{StaticResource TextSecondary}" Margin="0,60,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Catalogue -->
            <Grid x:Name="CatalogView" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="CategoryList" Style="{StaticResource BareListBox}" Margin="22,8,8,16"
                         ItemContainerStyle="{StaticResource CategoryItem}" SelectionChanged="Category_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Category}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Margin="10,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Column="1" Margin="8,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="12,6,0,6">
                        <TextBlock x:Name="HeaderTitle" FontSize="30" FontWeight="Bold" />
                        <TextBlock x:Name="HeaderCount" FontSize="15" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Bottom" Margin="12,0,0,6" />
                    </StackPanel>

                    <ListBox x:Name="PosterList" Grid.Row="1" Style="{StaticResource TileList}" ItemTemplate="{StaticResource PosterTemplate}"
                             KeyDown="TileList_KeyDown" />
                    <ListBox x:Name="LiveList" Grid.Row="1" Style="{StaticResource TileList}" ItemTemplate="{StaticResource LiveTemplate}"
                             KeyDown="TileList_KeyDown" Visibility="Collapsed" />

                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyText" FontSize="17" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                        <Button x:Name="RetryButton" Content="Réessayer" Style="{StaticResource SecondaryButton}" Margin="0,18,0,0"
                                HorizontalAlignment="Center" Click="Retry_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Programme en cours (survol ou flèches du clavier sur une chaîne) -->
            <Border x:Name="EpgCard" Grid.Row="1" Width="440" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,26"
                    Background="#F51C1C1E" CornerRadius="18" Padding="18,16" BorderBrush="#26FFFFFF" BorderThickness="1"
                    IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.65" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource Surface2}" VerticalAlignment="Top" Margin="0,0,16,0">
                        <Image x:Name="EpgLogo" Margin="8" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="EpgChannel" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="EpgNowPanel" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FF453A" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="EN COURS" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock x:Name="EpgNowTime" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="EpgNowTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                       MaxHeight="48" TextTrimming="WordEllipsis" />
                            <ProgressBar x:Name="EpgProgress" Style="{StaticResource SlimProgress}" Maximum="100" Margin="0,10,0,0" />
                            <TextBlock x:Name="EpgNowDesc" FontSize="13" LineHeight="19" Foreground="#AEAEB2" TextWrapping="Wrap" Margin="0,10,0,0"
                                       MaxHeight="57" TextTrimming="WordEllipsis" />
                        </StackPanel>
                        <Grid x:Name="EpgNextPanel" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EpgNextTime" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
                            <TextBlock x:Name="EpgNextTitle" Grid.Column="1" FontSize="13" Foreground="#D1D1D6" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock x:Name="EpgStatus" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== FICHE DÉTAIL ===================== -->
        <Grid x:Name="DetailView" Visibility="Collapsed" Background="{StaticResource Bg}">
            <Image x:Name="DetailBackdrop" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Right" Opacity="0.6" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F20A0A0C" Offset="0" />
                        <GradientStop Color="#B30A0A0C" Offset="0.45" />
                        <GradientStop Color="#1A0A0A0C" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000A0A0C" Offset="0.35" />
                        <GradientStop Color="#FF0A0A0C" Offset="0.95" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="64,28,64,48">
                    <Grid Margin="-12,0,0,30">
                        <Button Content="‹  Retour" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" FontSize="15"
                                Click="DetailBack_Click" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Downloads_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Téléchargements" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="250" Height="375" CornerRadius="16" Background="{StaticResource Surface}" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                            <Border CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush x:Name="DetailPoster" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="48,6,0,0" MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock x:Name="DetailTitle" FontSize="44" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailMeta" FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <StackPanel x:Name="VersionPanel" Margin="0,22,0,0" Visibility="Collapsed">
                                <TextBlock Text="VERSION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,8" />
                                <ListBox x:Name="VersionList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource PillItem}"
                                         DisplayMemberPath="VersionLabel" SelectionChanged="Version_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Click="Play_Click" MinWidth="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#0A0A0C"
                                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock x:Name="PlayLabel" Text="Lecture" Foreground="#0A0A0C" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FavButton" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="Fav_Click" />
                                <Button x:Name="DownloadButton" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="DownloadMovie_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Télécharger" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="DetailPlot" FontSize="16" LineHeight="25" Foreground="#D1D1D6" TextWrapping="Wrap" Margin="0,28,0,0" />
                            <TextBlock x:Name="DetailPeople" FontSize="13" LineHeight="21" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,18,0,0" />
                            <TextBlock x:Name="DetailLoading" Text="Chargement…" FontSize="14" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,18,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- Saisons / épisodes -->
                    <StackPanel x:Name="SeriesPanel" Margin="0,44,0,0" Visibility="Collapsed">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="SeasonList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource PillItem}"
                                 DisplayMemberPath="Label" SelectionChanged="Season_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="18,8" FontSize="14" VerticalAlignment="Top"
                                Click="DownloadSeason_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Télécharger la saison" />
                            </StackPanel>
                        </Button>
                        </Grid>

                            <ListBox x:Name="EpisodeList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource EpisodeClickable}"
                                     Margin="-10,18,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:Episode}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="224" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="2" Content="&#xE896;" Style="{StaticResource SmallIconButton}" Margin="16,0,6,0"
                                                    VerticalAlignment="Center" ToolTip="Télécharger cet épisode" Click="DownloadEpisode_Click" />
                                            <Border Width="208" Height="117" CornerRadius="12" Background="{StaticResource Surface}" HorizontalAlignment="Left">
                                                <Grid>
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border CornerRadius="12">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Image, Converter={StaticResource PosterImage}}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="760" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Duration}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Plot}" FontSize="13" Foreground="#AEAEB2" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="WordEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================== TÉLÉCHARGEMENTS ===================== -->
        <Grid x:Name="DownloadsView" Visibility="Collapsed">
            <Rectangle Fill="#99000000" MouseLeftButtonDown="DownloadsClose_Click" />
            <Border Width="460" HorizontalAlignment="Right" Background="#FF141416" BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0">
                <Grid Margin="24,24,16,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Téléchargements" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Content="&#xE8BB;" Style="{StaticResource SmallIconButton}" FontSize="12" HorizontalAlignment="Right"
                                ToolTip="Fermer" Click="DownloadsClose_Click" />
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="DownloadFolderText" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Margin="0,8,8,16" TextTrimming="CharacterEllipsis" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DownloadList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:DownloadItem}">
                                    <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16,14" Margin="0,0,8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}" />
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,8" />
                                                <ProgressBar Style="{StaticResource SlimProgress}" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Button Content="&#xE768;" Style="{StaticResource SmallIconButton}" ToolTip="Lire le fichier"
                                                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" Click="DownloadPlay_Click" />
                                                <Button Content="&#xE838;" Style="{StaticResource SmallIconButton}" Margin="6,0,0,0" ToolTip="Afficher dans le dossier"
                                                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" Click="DownloadOpenFolder_Click" />
                                                <Button Content="&#xE72C;" Style="{StaticResource SmallIconButton}" ToolTip="Réessayer"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" Click="DownloadRetry_Click" />
                                                <Button Content="&#xE711;" Style="{StaticResource SmallIconButton}" ToolTip="Annuler"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" Click="DownloadCancel_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="DownloadsEmpty" Grid.Row="2" Text="Aucun téléchargement.&#x0a;Utilisez le bouton Télécharger sur la fiche d'un film ou d'un épisode."
                               Foreground="{StaticResource TextSecondary}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="20,0" />

                    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button Content="Ouvrir le dossier" Style="{StaticResource GhostButton}" Click="DownloadsOpenRoot_Click" />
                        <Button Content="Changer de dossier" Style="{StaticResource GhostButton}" Click="DownloadsChangeFolder_Click" />
                        <Button Content="Effacer les terminés" Style="{StaticResource GhostButton}" Click="DownloadsClear_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== MISE À JOUR ===================== -->
        <Border x:Name="UpdateBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="#F21C1C1E" CornerRadius="18" Padding="22,16" BorderBrush="#26FFFFFF" BorderThickness="1" MaxWidth="640">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Background="#0A84FF" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="240">
                    <TextBlock x:Name="UpdateTitle" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateText" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="WordEllipsis" />
                    <ProgressBar x:Name="UpdateProgress" Style="{StaticResource SlimProgress}" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="UpdateLaterButton" Content="Plus tard" Style="{StaticResource GhostButton}" Click="UpdateLater_Click" />
                    <Button x:Name="UpdateNowButton" Content="Mettre à jour" Style="{StaticResource PrimaryButton}" Padding="20,9" FontSize="14"
                            Margin="8,0,0,0" Click="UpdateNow_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== CHARGEMENT ===================== -->
        <Grid x:Name="LoadingView" Background="#B30A0A0C" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="44" Height="44" StrokeThickness="4" StrokeDashArray="18 30" StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5" Stroke="#F5F5F7">
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock x:Name="LoadingText" Text="Chargement…" FontSize="15" Foreground="{StaticResource TextSecondary}"
                           Margin="0,18,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ===================== JINGLE D'OUVERTURE (silencieux) ===================== -->
        <Grid x:Name="SplashView" Background="Black" MouseLeftButtonDown="Splash_Skip" Cursor="Hand">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="SplashLogo" Width="168" Height="168" RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="SplashScale" ScaleX="0.82" ScaleY="0.82" />
                    </Grid.RenderTransform>
                    <Grid.Effect>
                        <DropShadowEffect x:Name="SplashGlow" Color="#5E5CE6" BlurRadius="90" ShadowDepth="0" Opacity="0" />
                    </Grid.Effect>
                    <Image Source="/Assets/BibiTv.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Reflet qui balaie le logo -->
                    <Rectangle>
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Assets/BibiTv.png" />
                        </Rectangle.OpacityMask>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="SplashSweep" X="-1.2" Y="-1.2" />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#00FFFFFF" Offset="0.35" />
                                <GradientStop Color="#99FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="0.65" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <TextBlock x:Name="SplashWord" Text="BibiTV" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,28,0,0" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="SplashWordShift" Y="14" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
